{
    "$intersystems_payer_services_hp_atrNote": "remove any sections from this sample that you do not need for your configuration",
    "intersystems_payer_services_hp_atr": {
        "$productionSettingsNote": "interoperability production configuration and settings",
        "$productionSettingsDocs": [
            "https://docs.intersystems.com/healthmodules/csp/docbook/DocBook.UI.Page.cls?KEY=HMDEPLOY_prereq_jsonconfig#HMDEPLOY_prereq_jsonconfig_prod",
            "https://docs.intersystems.com/irisforhealthlatest/csp/docbook/DocBook.UI.Page.cls?KEY=ECONFIG_config_settings"
        ],
        "productionSettings": {
            "productionName": "HS.HP.ATR.Local.Production",
            "items": [
                {
                    "$nameNote": "the business host name",
                    "name": "HS.HP.ATR.Interop.UpdateFileService",
                    "settings": [
                        {
                            "settingName": "FilePath",
                            "settingValue": "<instance durable data ingestion directory>/<namespace name>/csv-update",
                            "target": "Adapter"
                        },
                        {
                            "settingName": "FileSpec",
                            "settingValue": "*.csv",
                            "target": "Adapter"
                        }
                    ]
                },
                {
                    "$nameNote": "the business host name",
                    "name": "HS.HP.ATR.Interop.DeletionFileService",
                    "settings": [
                        {
                            "settingName": "FilePath",
                            "settingValue": "<instance durable data ingestion directory>/<namespace name>/csv-delete",
                            "target": "Adapter"
                        },
                        {
                            "settingName": "FileSpec",
                            "settingValue": "*.csv",
                            "target": "Adapter"
                        }
                    ]
                }
            ]
        }
    }
}